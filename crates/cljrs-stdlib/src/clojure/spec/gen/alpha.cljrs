  "NOT IMPLEMENTED: generative testing is not supported in clojurust."
  [& _args]
  (not-implemented "elements"))

(defn int
  "NOT IMPLEMENTED: generative testing is not supported in clojurust.
  (Shadows clojure.core/int in this ns, matching upstream.)"
  [& _args]
  (not-implemented "int"))

