(ns cljrs.raster-test
  "clojure.test suite for the native `cljrs.raster` namespace.

  Assertions are made against pixels wherever possible: a rasterizer that
  reports the right dimensions and throws no exceptions can still draw nothing,
  so every drawing test reads back a pixel that must have changed and one that
  must not have."
  (:require [clojure.test :refer [deftest is testing]]
            [cljrs.raster :as r]))

;; ── helpers ──────────────────────────────────────────────────────────────────

(defn- opaque-white [] [255 255 255 255])

(defn- blank
  "A white canvas of the given size."
  [w h]
  (doto (r/canvas w h) (r/clear! :white)))

;; ── canvas ───────────────────────────────────────────────────────────────────

(deftest canvas-dimensions
  (let [c (r/canvas 64 32)]
    (is (r/canvas? c))
    (is (= 64 (r/width c)))
    (is (= 32 (r/height c)))))

(deftest a-fresh-canvas-is-transparent
  (is (= [0 0 0 0] (r/pixel (r/canvas 4 4) 0 0))))

(deftest clear-fills-every-pixel
  (let [c (blank 8 8)]
    (is (= (opaque-white) (r/pixel c 0 0)))
    (is (= (opaque-white) (r/pixel c 7 7)))))

(deftest pixel-outside-the-canvas-is-nil
  (is (nil? (r/pixel (r/canvas 4 4) 99 0))))

(deftest set-pixel-round-trips
  (let [c (r/canvas 4 4)]
    (r/set-pixel! c 1 2 [10 20 30 255])
    (is (= [10 20 30 255] (r/pixel c 1 2)))
    (is (= [0 0 0 0] (r/pixel c 0 0)) "neighbours are untouched")))

(deftest set-pixel-outside-the-canvas-throws
  (is (thrown? Exception (r/set-pixel! (r/canvas 4 4) 9 9 :red))))

(deftest clone-canvas-is-independent
  (let [a (blank 4 4)
        b (r/clone-canvas a)]
    (r/clear! b :black)
    (is (= (opaque-white) (r/pixel a 0 0)))
    (is (= [0 0 0 255] (r/pixel b 0 0)))))

;; ── colour spellings ─────────────────────────────────────────────────────────

(deftest colour-spellings-agree
  (testing "keyword, hex and integer vector name the same colour"
    (let [expect [70 130 180 255]]
      (doseq [spec [:steelblue "#4682b4" "#4682b4ff" [70 130 180] [70 130 180 255]]]
        (let [c (r/canvas 2 2)]
          (r/clear! c spec)
          (is (= expect (r/pixel c 0 0)) (str "for " (pr-str spec))))))))

(deftest float-channels-are-0-to-1
  (let [c (r/canvas 2 2)]
    (r/clear! c [1.0 1.0 1.0 1.0])
    (is (= (opaque-white) (r/pixel c 0 0))))
  (testing "integer 1 is near-black, float 1.0 is white — as in Clojure itself"
    (let [c (r/canvas 2 2)]
      (r/clear! c [1 1 1])
      (is (= [1 1 1 255] (r/pixel c 0 0))))))

(deftest short-hex-expands
  (let [c (r/canvas 2 2)]
    (r/clear! c "#f00")
    (is (= [255 0 0 255] (r/pixel c 0 0)))))

(deftest an-unknown-colour-throws
  (is (thrown? Exception (r/clear! (r/canvas 2 2) :chartreusey)))
  (is (thrown? Exception (r/clear! (r/canvas 2 2) "#12345"))))

;; ── drawing ──────────────────────────────────────────────────────────────────

(deftest fill-rect-covers-only-its-rect
  (let [c (blank 32 32)]
    (r/fill-rect! c 8 8 16 16 {:color :red})
    (is (= [255 0 0 255] (r/pixel c 16 16)) "inside")
    (is (= (opaque-white) (r/pixel c 1 1)) "outside")))

(deftest fill-rect-without-options-defaults-to-black
  (let [c (blank 16 16)]
    (r/fill-rect! c 4 4 8 8)
    (is (= [0 0 0 255] (r/pixel c 8 8)))))

(deftest fill-circle-is-round
  (let [c (blank 40 40)]
    (r/fill-circle! c 20 20 12 {:color :blue})
    (is (= [0 0 255 255] (r/pixel c 20 20)) "centre is filled")
    (is (= (opaque-white) (r/pixel c 1 1)) "the corner is outside the disc")))

(deftest a-path-fills-where-it-should
  (let [c (blank 40 40)
        tri (r/polygon [[4 36] [20 4] [36 36]])]
    (r/fill-path! c tri {:color :black})
    (is (= [0 0 0 255] (r/pixel c 20 30)) "inside the triangle")
    (is (= (opaque-white) (r/pixel c 1 1)) "outside it")))

(deftest stroke-draws-an-outline-not-a-fill
  (let [c (blank 40 40)]
    (r/stroke-path! c (r/rect 10 10 20 20) {:color :black :width 2})
    (is (= (opaque-white) (r/pixel c 20 20)) "the interior is untouched")
    (is (not= (opaque-white) (r/pixel c 10 20)) "the edge is painted")))

(deftest stroke-line-paints-the-line
  (let [c (blank 40 40)]
    (r/stroke-line! c 0 20 39 20 {:color :black :width 3})
    (is (= [0 0 0 255] (r/pixel c 20 20)))
    (is (= (opaque-white) (r/pixel c 20 2)))))

(deftest a-transform-moves-what-is-drawn
  (let [c (blank 40 40)]
    (r/fill-rect! c 0 0 8 8 {:color :red :transform {:translate [20 20]}})
    (is (= [255 0 0 255] (r/pixel c 24 24)) "drawn at the translated position")
    (is (= (opaque-white) (r/pixel c 2 2)) "not at the original one")))

(deftest a-gradient-varies-across-the-shape
  (let [c (blank 64 16)]
    (r/fill-rect! c 0 0 64 16
                  {:gradient {:type :linear :start [0 0] :end [64 0]
                              :stops [[0.0 :black] [1.0 :white]]}})
    (let [left (first (r/pixel c 1 8))
          right (first (r/pixel c 62 8))]
      (is (< left right) "the ramp runs dark to light"))))

(deftest a-gradient-needs-stops
  (is (thrown? Exception
               (r/fill-rect! (r/canvas 8 8) 0 0 8 8
                             {:gradient {:type :linear :start [0 0] :end [8 0]}}))))

(deftest draw-canvas-composites
  (let [dst (blank 32 32)
        src (doto (r/canvas 8 8) (r/clear! :red))]
    (r/draw-canvas! dst src 4 4)
    (is (= [255 0 0 255] (r/pixel dst 8 8)) "the sprite landed")
    (is (= (opaque-white) (r/pixel dst 1 1)) "the rest is untouched")))

(deftest draw-canvas-honours-opacity
  (let [dst (blank 16 16)
        src (doto (r/canvas 8 8) (r/clear! :black))]
    (r/draw-canvas! dst src 0 0 {:opacity 0.5})
    (let [[red] (r/pixel dst 4 4)]
      (is (and (pos? red) (< red 255)) "half-transparent black lands as grey"))))

;; ── paths ────────────────────────────────────────────────────────────────────

(deftest the-builder-threads-through-arrows
  (let [p (-> (r/path-builder)
              (r/move-to! 0 0)
              (r/line-to! 10 0)
              (r/line-to! 10 10)
              (r/close-path!)
              (r/finish-path))]
    (is (r/path? p))))

(deftest a-builder-is-single-use
  (let [b (r/path-builder)]
    (r/push-rect! b 0 0 10 10)
    (is (r/path? (r/finish-path b)))
    (is (thrown? Exception (r/finish-path b)) "finishing twice is refused")
    (is (thrown? Exception (r/move-to! b 1 1)) "so is drawing into a spent builder")))

(deftest an-empty-path-cannot-be-finished
  (is (thrown? Exception (r/finish-path (r/path-builder)))))

(deftest curves-build
  (let [p (-> (r/path-builder)
              (r/move-to! 0 0)
              (r/quad-to! 5 10 10 0)
              (r/cubic-to! 12 4 16 -4 20 0)
              (r/finish-path))]
    (is (r/path? p))))

(deftest one-shot-constructors-make-paths
  (is (r/path? (r/rect 0 0 10 10)))
  (is (r/path? (r/oval 0 0 10 20)))
  (is (r/path? (r/circle 5 5 5)))
  (is (r/path? (r/polygon [[0 0] [10 0] [5 10]])))
  (is (r/path? (r/polyline [[0 0] [10 10]]))))

(deftest a-polyline-needs-two-points
  (is (thrown? Exception (r/polyline [[0 0]]))))

(deftest a-canvas-is-not-a-path
  (is (not (r/path? (r/canvas 2 2))))
  (is (not (r/canvas? (r/rect 0 0 1 1))))
  (is (thrown? Exception (r/fill-path! (r/canvas 4 4) (r/canvas 4 4)))))

;; ── encoding ─────────────────────────────────────────────────────────────────

(deftest png-round-trips-through-bytes
  (let [c (blank 12 9)]
    (r/fill-rect! c 2 2 4 4 {:color :red})
    (let [png (r/encode-png c)
          back (r/decode-png png)]
      (is (pos? (alength png)))
      (is (= 12 (r/width back)))
      (is (= 9 (r/height back)))
      (is (= (r/pixel c 4 4) (r/pixel back 4 4))))))

(deftest a-png-starts-with-the-png-signature
  (let [png (r/encode-png (r/canvas 2 2))]
    (is (= [-119 80 78 71] (vec (take 4 (vec png)))) "\\x89PNG")))

(deftest rgba-bytes-are-four-per-pixel
  (let [c (blank 5 7)]
    (is (= (* 5 7 4) (alength (r/rgba-bytes c))))))

(deftest rgba-round-trips
  (let [c (blank 6 6)]
    (r/fill-rect! c 1 1 3 3 {:color [12 34 56 255]})
    (let [back (r/from-rgba 6 6 (r/rgba-bytes c))]
      (is (= [12 34 56 255] (r/pixel back 2 2)))
      (is (= (r/pixel c 0 0) (r/pixel back 0 0))))))

(deftest from-rgba-checks-the-byte-count
  (is (thrown? Exception (r/from-rgba 4 4 (r/rgba-bytes (r/canvas 2 2))))))

(deftest decoding-junk-throws
  (is (thrown? Exception (r/decode-png [1 2 3 4]))))

;; ── SVG ──────────────────────────────────────────────────────────────────────

(def ^:private doc
  "<svg xmlns='http://www.w3.org/2000/svg' width='40' height='20'>
     <rect x='0' y='0' width='20' height='20' fill='#ff0000'/>
   </svg>")

(deftest svg-size-reports-the-documents-own-size
  (is (= [40.0 20.0] (r/svg-size doc))))

(deftest render-svg-uses-the-intrinsic-size-by-default
  (let [c (r/render-svg doc)]
    (is (r/canvas? c))
    (is (= 40 (r/width c)))
    (is (= 20 (r/height c)))))

(deftest render-svg-draws-the-document
  (let [c (r/render-svg doc)]
    (is (= [255 0 0 255] (r/pixel c 10 10)) "inside the rect")
    (is (= [0 0 0 0] (r/pixel c 30 10)) "outside it, and transparent by default")))

(deftest a-background-fills-behind-the-document
  (let [c (r/render-svg doc {:background :white})]
    (is (= [255 0 0 255] (r/pixel c 10 10)))
    (is (= [255 255 255 255] (r/pixel c 30 10)))))

(deftest one-dimension-scales-the-other
  (testing "keeping the aspect ratio is what \"render this 80 wide\" means"
    (let [c (r/render-svg doc {:width 80})]
      (is (= [80 40] [(r/width c) (r/height c)])))
    (let [c (r/render-svg doc {:height 40})]
      (is (= [80 40] [(r/width c) (r/height c)])))))

(deftest both-dimensions-are-taken-literally
  (let [c (r/render-svg doc {:width 100 :height 10})]
    (is (= [100 10] [(r/width c) (r/height c)]))))

(deftest scale-multiplies-the-intrinsic-size
  (let [c (r/render-svg doc {:scale 3})]
    (is (= [120 60] [(r/width c) (r/height c)]))))

(deftest scaling-still-draws-in-the-right-place
  (let [c (r/render-svg doc {:scale 4})]
    (is (= [255 0 0 255] (r/pixel c 40 40)) "the rect scaled with the document")
    (is (= [0 0 0 0] (r/pixel c 120 40)))))

(deftest text-renders
  (testing "the whole reason this exists: tiny-skia has no font stack, so a
            <text> element is how glyphs reach a canvas"
    (let [c (r/render-svg
             "<svg xmlns='http://www.w3.org/2000/svg' width='200' height='50'>
                <text x='5' y='35' font-size='30' fill='#ffffff'>iiii</text>
              </svg>")
          ;; Any non-transparent pixel means glyphs were rasterized. When the
          ;; default font family resolves to nothing, resvg logs a warning and
          ;; draws an empty canvas, which is exactly the failure this catches.
          painted (count (filter (fn [[_ _ _ a]] (pos? a))
                                 (for [x (range 200)]
                                   (r/pixel c x 25))))]
      (is (pos? painted) "no glyphs were rasterized"))))

(deftest a-named-font-family-is-accepted
  (is (r/canvas? (r/render-svg doc {:font-family "DejaVu Sans"}))))

(deftest malformed-svg-throws
  (is (thrown? Exception (r/render-svg "not an svg at all"))))

(deftest loading-a-missing-svg-file-throws
  (is (thrown? Exception (r/load-svg "/definitely/not/here.svg"))))
