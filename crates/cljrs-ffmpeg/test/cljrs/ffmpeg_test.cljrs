(ns cljrs.ffmpeg-test
  "Tests for `cljrs.ffmpeg` that never start a process.

  Everything here is argument validation and refusal behaviour, so it runs on a
  machine with no FFmpeg installed. The tests that actually encode live in
  `cljrs.ffmpeg-encode-test`, which the Rust harness skips — loudly — when the
  binaries are missing, rather than reporting a pass for something it did not
  run."
  (:require [clojure.test :refer [deftest is testing]]
            [cljrs.ffmpeg :as ff]))

(deftest available?-answers-a-boolean
  (is (contains? #{true false} (ff/available?))))

(deftest a-writer-needs-its-geometry
  (testing "the frame size is not guessable, so it is required"
    (is (thrown? Exception (ff/video-writer "out.mp4" {})))
    (is (thrown? Exception (ff/video-writer "out.mp4" {:width 320})))
    (is (thrown? Exception (ff/video-writer "out.mp4" {:height 180})))))

(deftest odd-dimensions-are-refused-before-spawning
  (testing "4:2:0 chroma is half-resolution, so an odd side has no encoding"
    (is (thrown? Exception
                 (ff/video-writer "out.mp4" {:width 321 :height 180 :fps 30})))
    (is (thrown? Exception
                 (ff/video-writer "out.mp4" {:width 320 :height 181 :fps 30})))))

(deftest zero-dimensions-are-refused
  (is (thrown? Exception (ff/video-writer "out.mp4" {:width 0 :height 180}))))

(deftest probing-a-missing-file-throws
  (is (thrown? Exception (ff/probe "./definitely-not-here.mp4")))
  (is (thrown? Exception (ff/duration "./definitely-not-here.mp4")))
  (is (thrown? Exception (ff/dimensions "./definitely-not-here.mp4"))))

(deftest run-wants-a-vector-of-arguments
  (is (thrown? Exception (ff/run "-version")))
  (is (thrown? Exception (ff/run {:args ["-version"]}))))

(deftest writer-predicates-reject-non-writers
  (is (false? (ff/writer? "not a writer")))
  (is (false? (ff/writer? nil)))
  (is (thrown? Exception (ff/close-writer! "not a writer")))
  (is (thrown? Exception (ff/frames-written 42))))

(deftest transcode-and-extract-want-string-paths
  (is (thrown? Exception (ff/extract-frame! 1 "out.png")))
  (is (thrown? Exception (ff/transcode! "in.mp4" :out))))
