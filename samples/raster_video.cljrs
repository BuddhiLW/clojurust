;; raster_video.cljrs — draw with `cljrs.raster`, encode with `cljrs.ffmpeg`.
;;
;;   cljrs run samples/raster_video.cljrs
;;
;; Writes /tmp/cljrs-orbit.png and, when ffmpeg is installed,
;; /tmp/cljrs-orbit.mp4 — 4 seconds of three bodies on an orbit, rendered a
;; frame at a time straight into the encoder's stdin. Nothing intermediate
;; touches the disk: `rgba-bytes` hands the canvas's raw pixels to a live ffmpeg
;; child. The two namespaces meet here, at that byte layout, and nowhere else.

(require '[cljrs.raster :as r])
(require '[cljrs.ffmpeg :as ff])

(def width 480)
(def height 270)
(def fps 30)
(def seconds 4)

(def palette [:gold :crimson :turquoise])

(defn orbit
  "Position of body `i` at time `t` seconds, on an ellipse about the centre."
  [i t]
  (let [phase (+ (* t 1.6) (* i (/ (* 2 Math/PI) (count palette))))]
    [(+ (/ width 2.0) (* 150 (Math/cos phase)))
     (+ (/ height 2.0) (* 70 (Math/sin phase)))]))

(defn frame
  "One frame at time `t`."
  [t]
  (let [c (r/canvas width height)]
    ;; Background: a vertical gradient, drawn as one filled rect.
    (r/fill-rect! c 0 0 width height
                  {:gradient {:type :linear
                              :start [0 0] :end [0 height]
                              :stops [[0.0 "#0b1020"] [1.0 "#1b2b4a"]]}})
    ;; The orbit itself, as a dashed ellipse.
    (r/stroke-path! c (r/oval (- (/ width 2.0) 150) (- (/ height 2.0) 70) 300 140)
                    {:color [255 255 255 60] :width 1.5 :dash {:array [6 6]}})
    ;; The bodies, largest first so the smaller ones stay visible.
    (doseq [i (range (count palette))]
      (let [[x y] (orbit i t)
            colour (nth palette i)]
        ;; A soft halo, then the body.
        (r/fill-circle! c x y 22 {:gradient {:type :radial
                                             :start [x y] :end [x y] :radius 22
                                             :stops [[0.0 colour] [1.0 [0 0 0 0]]]}})
        (r/fill-circle! c x y 8 {:color colour})))
    c))

;; A single still, to look at without a video player.
(let [c (frame 0.4)]
  (r/save-png! c "/tmp/cljrs-orbit.png")
  (println "still:  /tmp/cljrs-orbit.png"
           (str (r/width c) "x" (r/height c))
           (str (alength (r/encode-png c)) " bytes")))

(if-not (ff/available?)
  (println "ffmpeg: not on PATH — skipping the video")
  (let [out "/tmp/cljrs-orbit.mp4"
        total (* fps seconds)
        w (ff/video-writer out {:width width :height height :fps fps :crf 20})]
    (dotimes [i total]
      (ff/write-frame! w (r/rgba-bytes (frame (/ (double i) fps)))))
    (let [{:keys [exit frames error]} (ff/close-writer! w)]
      (if (zero? exit)
        (println "video: " out
                 (str frames " frames")
                 (str (ff/duration out) "s")
                 (ff/dimensions out))
        (println "video failed:" exit error)))))
