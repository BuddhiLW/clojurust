(require 'malli.core)
(println :malli-loaded)
(println (malli.core/validate :int 1))
(println (malli.core/validate :int "x"))
(println (malli.core/form [:map [:a :int]]))
(println (malli.core/validate [:map [:a :int]] {:a 1}))
(println (malli.core/explain [:map [:a :int]] {:a "wrong"}))
(println ((malli.core/validator [:map [:a :int]]) {:a 1}))
(println (malli.core/parse [:cat :int :string] [1 "a"]))
(println (malli.core/validate [:* :int] [1 2 3]))
(require 'malli.error 'malli.transform 'malli.util)
(println (malli.error/humanize (malli.core/explain [:map [:a :int]] {:a "x"})))
(println (malli.core/decode [:map [:a :int]] {:a "1"} (malli.transform/string-transformer)))
(println (malli.core/form (malli.util/merge [:map [:a :int]] [:map [:b :int]])))
